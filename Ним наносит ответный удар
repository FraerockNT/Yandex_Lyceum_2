import sys
import random
from PyQt6.QtWidgets import QApplication, QWidget, QLineEdit, QPushButton, QLabel, QVBoxLayout


class NimStrikesBack(QWidget):

    def __init__(self):
        super().__init__()

        self.setGeometry(100, 100, 300, 200)
        self.setWindowTitle('Ним наносит ответный удар')

        self.X = 0
        self.Y = 0
        self.Z = 0
        self.moves_remaining = 0

        self.result_label = QLabel(self)
        self.result_label.setText("")

        self.label_current_number = QLabel(self)
        self.label_current_number.setText("Текущее число: ")

        self.output_current_number = QLineEdit(self)
        self.output_current_number.setEnabled(False)

        self.label_moves = QLabel(self)
        self.label_moves.setText("Осталось ходов: ")

        self.output_moves = QLineEdit(self)
        self.output_moves.setEnabled(False)

        self.btnp = QPushButton(self)
        self.btnp.clicked.connect(self.add_to_x)

        self.btnm = QPushButton(self)
        self.btnm.clicked.connect(self.subtract_from_x)

        layout = QVBoxLayout()
        layout.addWidget(self.label_current_number)
        layout.addWidget(self.output_current_number)
        layout.addWidget(self.label_moves)
        layout.addWidget(self.output_moves)
        layout.addWidget(self.btnp)
        layout.addWidget(self.btnm)
        layout.addWidget(self.result_label)

        self.setLayout(layout)

        self.new_game()

    def new_game(self):
        self.X = random.randint(1, 10) 
        self.Y = random.randint(1, 10)
        self.Z = random.randint(1, 10)
        self.moves_remaining = 10 
        
        self.output_current_number.setText(str(self.X))
        self.output_moves.setText(str(self.moves_remaining))
        self.btnp.setText(f'+{self.Y}')
        self.btnm.setText(f'-{self.Z}')

    def add_to_x(self):
        self.result_label.setText("")  
        self.X += self.Y
        self.moves_remaining -= 1
        self.check_game_status()

    def subtract_from_x(self):
        self.result_label.setText("") 
        self.X -= self.Z
        self.moves_remaining -= 1
        self.check_game_status()

    def check_game_status(self):
        self.output_current_number.setText(str(self.X))
        self.output_moves.setText(str(self.moves_remaining))

        if self.X == 0:
            self.result_label.setText('Вы победили!')
            self.new_game()  
        elif self.moves_remaining <= 0:
            self.result_label.setText('Вы проиграли!')
            self.new_game()  
            

if __name__ == "__main__":
    app = QApplication(sys.argv)
    wnd = NimStrikesBack()
    wnd.show()
    sys.exit(app.exec())
