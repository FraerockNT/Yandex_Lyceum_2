import csv
import sys

n, m = map(int, input().split())
ans = []
with open('exam.csv', 'w', encoding='utf-8') as w_exam:
    writer = csv.writer(w_exam, delimiter=';')
    writer.writerow(['Фамилия', 'имя', 'результат 1', 'результат 2', 'результат 3', 'сумма'])
    for i in sys.stdin.readlines():
        i = i.split()
        sm = (int(i[-1]) + int(i[-2]) + int(i[-3]))
        if int(i[-1]) >= m and int(i[-2]) >= m and int(i[-3]) >= m and sm >= n:
            ans = [*i, sm]
            writer.writerow(ans)
