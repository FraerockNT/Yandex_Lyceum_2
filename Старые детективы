import sqlite3

db_name = input()
con = sqlite3.connect(db_name)
cur = con.cursor()
result = cur.execute("""SELECT title FROM Films
            WHERE (genre=(
SELECT id FROM genres
            WHERE title = 'детектив')) AND year BETWEEN 1995 AND 2000""").fetchall()


for elem in result:
    print(elem[0])
    
con.close()
