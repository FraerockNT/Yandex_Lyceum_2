import sys

slova = []
isx = []
otvet = []
for line in sys.stdin:
    slova.append(line.rstrip('\n'))
for i in slova[0]:
    isx.append(i)
del slova[0]
for h in slova:
    a = 1
    nado = isx.copy()
    for letter in h:
        if letter not in nado:
            a = 0
            continue
        if letter in nado:
            nado.remove(letter)
    if a == 1:
        otvet.append(h)
print(len(otvet))
for k in otvet:
    print(k)
