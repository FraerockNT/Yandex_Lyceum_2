import sys
import csv
from PyQt6.QtWidgets import (
    QApplication, QMainWindow, QVBoxLayout, QWidget,
    QLineEdit, QTableWidget, QTableWidgetItem
)
from PyQt6.QtCore import Qt


class TitanicSearch(QMainWindow):
    def __init__(self):
        super().__init__()

        self.setWindowTitle("Titanic Passenger Search")
        self.setGeometry(100, 100, 800, 600)

        self.centralWidget = QWidget()
        self.setCentralWidget(self.centralWidget)

        self.layout = QVBoxLayout(self.centralWidget)

        self.searchEdit = QLineEdit(self)
        self.searchEdit.setPlaceholderText("Введите имя пассажира для поиска...")
        self.searchEdit.textChanged.connect(self.filter_results)
        self.layout.addWidget(self.searchEdit)

        self.resultTable = QTableWidget(self)
        self.layout.addWidget(self.resultTable)

        self.data = self.load_data("titanic.csv")
        self.update_table(self.data)

    def load_data(self, filename):
        with open(filename, newline='', encoding='utf-8') as csvfile:
            reader = csv.DictReader(csvfile)
            return list(reader)

    def update_table(self, data):
        self.resultTable.setRowCount(len(data))
        self.resultTable.setColumnCount(len(data[0]) if data else 0)
        self.resultTable.setHorizontalHeaderLabels(data[0].keys() if data else [])

        for row_index, row_data in enumerate(data):
            for col_index, (key, value) in enumerate(row_data.items()):
                item = QTableWidgetItem(str(value))
                self.resultTable.setItem(row_index, col_index, item)

                if row_data['Survived'] == '1':
                    item.setBackground(Qt.GlobalColor.green)
                else:
                    item.setBackground(Qt.GlobalColor.red)

    def filter_results(self):
        search_text = self.searchEdit.text()
        if len(search_text) < 3:
            self.update_table(self.data)
        else:
            filtered_data = [row for row in self.data if search_text.lower() in row['Name'].lower()]
            self.update_table(filtered_data)


if __name__ == "__main__":
    app = QApplication(sys.argv)
    window = TitanicSearch()
    window.show()
    sys.exit(app.exec())
