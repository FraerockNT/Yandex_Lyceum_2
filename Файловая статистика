import sys
from PyQt6.QtWidgets import (
    QApplication, QMainWindow, QWidget, QVBoxLayout,
    QLineEdit, QPushButton, QStatusBar, QLabel
)


class FileStat(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle('Статистика файла')
        self.setGeometry(300, 300, 400, 300)

        self.central_widget = QWidget()
        self.setCentralWidget(self.central_widget)

        self.layout = QVBoxLayout()
        self.central_widget.setLayout(self.layout)

        self.filenameEdit = QLineEdit(self)
        self.filenameEdit.setPlaceholderText('Введите имя файла')
        self.layout.addWidget(self.filenameEdit)

        self.button = QPushButton('Получить статистику', self)
        self.button.clicked.connect(self.calculateStatistics)
        self.layout.addWidget(self.button)

        self.minEdit = QLineEdit('0', self)
        self.minEdit.setReadOnly(True)
        self.layout.addWidget(QLabel('Минимальное значение:'))
        self.layout.addWidget(self.minEdit)

        self.maxEdit = QLineEdit('0', self)
        self.maxEdit.setReadOnly(True)
        self.layout.addWidget(QLabel('Максимальное значение:'))
        self.layout.addWidget(self.maxEdit)

        self.avgEdit = QLineEdit('0,00', self)
        self.avgEdit.setReadOnly(True)
        self.layout.addWidget(QLabel('Среднее значение:'))
        self.layout.addWidget(self.avgEdit)

        self.statusbar = QStatusBar()
        self.setStatusBar(self.statusbar)

    def calculateStatistics(self):
        filename = self.filenameEdit.text()
        self.minEdit.setText('0')
        self.maxEdit.setText('0') 
        self.avgEdit.setText('0,00')
        try:
            with open(filename, "r", encoding="utf-8") as file:
                content = file.read()
                if not content.strip():
                    self.statusbar.showMessage("Указанный файл пуст")
                    return

                numbers = []
                for i in content.split():
                    try:
                        number = int(i)
                        numbers.append(number)
                    except ValueError:
                        self.statusbar.showMessage("Файл содержит некорректные данные")
                        return

                if numbers:
                    self.maxEdit.setText(str(max(numbers)))
                    self.minEdit.setText(str(min(numbers)))
                    avg = "{:.2f}".format(sum(numbers) / len(numbers))
                    self.avgEdit.setText(str(avg))

                    with open('out.txt', 'w', encoding="utf-8") as res:
                        res.write("Максимальное значение = {}\nМинимальное значение = {}\nСреднее значение = {}".format(
                            max(numbers), min(numbers), avg))
                else:
                    self.statusbar.showMessage("Нет чисел для анализа")

        except FileNotFoundError:
            self.statusbar.showMessage("Указанный файл не существует")


if __name__ == '__main__':
    app = QApplication(sys.argv)
    window = FileStat()
    window.show()
    sys.exit(app.exec())
