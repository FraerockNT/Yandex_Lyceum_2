PITCHES = ["до", "ре", "ми", "фа", "соль", "ля", "си"]


class Note:
    def __init__(self, pithes=PITCHES[0], is_long=False):
        self.name = pithes
        self.long = is_long
        self.loud = False
        self.octave = ''

    def __str__(self):
        note = {'до': 'до-о', 'ре': 'ре-э', 'ми': 'ми-и',
                'фа': 'фа-а', 'соль': 'со-оль', 'ля': 'ля-а', 'си': 'си-и'}
        if self.long:
            self.name = note[self.name]
        if self.loud:
            self.name = self.name.upper()
        return self.name + self.octave


class DefaultNote(Note):
    def __init__(self, pithes=PITCHES[0], is_long=False):
        super().__init__(pithes, is_long)
        self.name = pithes
        self.long = is_long
        self.loud = False
        self.octave = ''


class LoudNote(Note):
    def __init__(self, pithes=PITCHES[0], is_long=False):
        super().__init__(pithes, is_long)
        self.name = pithes
        self.long = is_long
        self.loud = True
        self.octave = ''


class NoteWithOctave(Note):
    def __init__(self, pithes=PITCHES[0], octave='', is_long=False):
        super().__init__(pithes, is_long)
        self.name = pithes
        self.long = is_long
        self.loud = False
        self.octave = octave if not octave else f' ({octave})'
