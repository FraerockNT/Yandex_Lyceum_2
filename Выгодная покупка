import csv

with open('wares.csv', encoding="utf8") as csvfile:
    ans = []
    reader = csv.reader(csvfile, delimiter=';', quotechar=',')
    sort_reader = sorted(reader, key=lambda x: int(x[1]))
    money = 1000
    while money >= 1000:
        for name, price in sort_reader:
            n = 10
            if int(price) <= money:
                while n != 0 and money - int(price) >= 0:
                    ans.append(name)
                    money -= int(price)
                    n -= 1
        break
    if len(ans) == 0:
        print('error')
    else:
        print(', '.join(ans))
