def check_tel(s):
    s = s.strip()
    s = ''.join(s.split())
    if s.startswith('+7'):
        s = s[2:]
    elif s.startswith('8'):
        s = s[1:]
    else:
        raise ValueError("error")
    if s.endswith('-') or '--' in s:
        raise ValueError("error")
    s = ''.join(s.split('-'))
    ss = ''.join(x for x in s if x in '()')
    if ss not in ['', '()']:
        raise ValueError("error")
    s = s.replace('(', '')
    s = s.replace(')', '')
    if not s.isdigit():
        raise ValueError("error")
    elif len(s) != 10:
        raise ValueError("error")
    return '+7' + s


try:
    print(check_tel(input()))
except ValueError as e:
    print(e)
    
