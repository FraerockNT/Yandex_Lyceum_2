import sys
from PyQt6.QtWidgets import (
    QApplication, QWidget, QPushButton, QRadioButton, QLabel, QVBoxLayout, QHBoxLayout, QGridLayout
)


class TicTacToe(QWidget):
    def __init__(self):
        super().__init__()

        self.button_grid = []
        self.result = QLabel(self)
        self.x_radio = QRadioButton('X', self)
        self.o_radio = QRadioButton('O', self)
        self.new_game_button = QPushButton('New Game', self)

        self.x_turn = True
        self.game_over = False

        self.initUI()

    def initUI(self):
        self.setGeometry(300, 300, 300, 300)
        self.setWindowTitle('Tic Tac Toe')

        # Layouts
        vbox = QVBoxLayout()
        hbox = QHBoxLayout()
        grid = QGridLayout()

        for i in range(3):
            row = []
            for j in range(3):
                button = QPushButton(self)
                button.clicked.connect(lambda checked, row=i, col=j: self.on_button_click(row, col))
                row.append(button)
                grid.addWidget(button, i, j)
            self.button_grid.append(row)

        hbox.addWidget(self.x_radio)
        hbox.addWidget(self.o_radio)
        self.x_radio.setChecked(True)
        self.x_turn = self.x_radio.isChecked()

        self.x_radio.toggled.connect(self.on_radio_toggle)
        self.o_radio.toggled.connect(self.on_radio_toggle)

        vbox.addWidget(self.result)

        vbox.addWidget(self.new_game_button)
        self.new_game_button.clicked.connect(self.new_game)

        vbox.addLayout(grid)
        vbox.addLayout(hbox)

        self.setLayout(vbox)

    def on_radio_toggle(self):
        self.x_turn = self.x_radio.isChecked()
        self.reset_game_state()

    def reset_game_state(self):
        for row in self.button_grid:
            for button in row:
                button.setText('')
                button.setEnabled(True)
        self.game_over = False
        self.result.setText('')

    def on_button_click(self, i, j):
        if not self.game_over:
            button = self.button_grid[i][j]
            if button.text() == '':
                if self.x_turn:
                    button.setText('X')
                    self.x_turn = False 
                else:
                    button.setText('O')
                    self.x_turn = True 
                self.check_game_over()
                
    def check_game_over(self):
        for i in range(3):
            if self.button_grid[i][0].text() == self.button_grid[i][1].text() == self.button_grid[i][2].text() != '':
                self.game_over = True
                self.result.setText(f"Выиграл {self.button_grid[i][0].text()}!")
                self.block_buttons()
                return
            if self.button_grid[0][i].text() == self.button_grid[1][i].text() == self.button_grid[2][i].text() != '':
                self.game_over = True
                self.result.setText(f"Выиграл {self.button_grid[0][i].text()}!")
                self.block_buttons()
                return
        if self.button_grid[0][0].text() == self.button_grid[1][1].text() == self.button_grid[2][2].text() != '':
            self.game_over = True
            self.result.setText(f"Выиграл {self.button_grid[0][0].text()}!")
            self.block_buttons()
            return
        if self.button_grid[0][2].text() == self.button_grid[1][1].text() == self.button_grid[2][0].text() != '':
            self.game_over = True
            self.result.setText(f"Выиграл {self.button_grid[0][2].text()}!")
            self.block_buttons()
            return
        if all(button.text() != '' for row in self.button_grid for button in row):
            self.game_over = True
            self.result.setText("Ничья!")
            self.block_buttons()

    def block_buttons(self):
        for row in self.button_grid:
            for button in row:
                button.setEnabled(False)

    def new_game(self):
        self.game_over = False
        self.x_turn = self.x_radio.isChecked()
        self.result.setText('')
        for row in self.button_grid:
            for button in row:
                button.setText('')
                button.setEnabled(True)
        if not self.x_turn:
            self.x_turn = False


if __name__ == '__main__':
    app = QApplication(sys.argv)
    ex = TicTacToe()
    ex.show()
    sys.exit(app.exec())
