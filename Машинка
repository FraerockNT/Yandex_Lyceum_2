import sys
from PyQt6 import QtWidgets, QtGui, QtCore


class Car(QtWidgets.QMainWindow):
    def __init__(self):
        super().__init__()
        self.setGeometry(100, 100, 300, 300)
        self.setFixedSize(300, 300)
        self.setWindowTitle('Машинка')

        self.images = [
            QtGui.QPixmap('car1.png'),
            QtGui.QPixmap('car2.png'),
            QtGui.QPixmap('car3.png')
        ]
        self.current_image_index = 0
        self.pixmap = self.images[self.current_image_index]

        self.lbl = QtWidgets.QLabel(self)
        self.lbl.setPixmap(self.pixmap)
        self.lbl.setScaledContents(True)
        self.lbl.setFixedSize(self.pixmap.size())
        self.lbl.move(0, 0)

        self.setMouseTracking(True)

    def mouseMoveEvent(self, event):
        mouse_x = int(event.position().x())
        mouse_y = int(event.position().y())

        if mouse_x > 250:
            mouse_x = 250
        if mouse_y > 250:
            mouse_y = 250

        self.lbl.move(mouse_x, mouse_y)

    def keyPressEvent(self, event):
        if event.key() == QtCore.Qt.Key.Key_Space:
            self.current_image_index = (self.current_image_index + 1) % 3
            self.pixmap = self.images[self.current_image_index]
            self.lbl.setPixmap(self.pixmap)
            self.lbl.setFixedSize(self.pixmap.size())
            self.lbl.move(self.lbl.x(), self.lbl.y())


if __name__ == '__main__':
    app = QtWidgets.QApplication(sys.argv)
    window = Car()
    window.show()
    sys.exit(app.exec())
